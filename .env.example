# Copy to .env for local dev (do NOT commit .env)

# --- Required ---
GCP_PROJECT_ID=supple-defender-331706
BQ_DATASET=geidea
BQ_TABLE=geidea_order_items

# --- Auth (shared username/password) ---
DASH_USERNAME=admin
DASH_PASSWORD=change-me-to-something-strong
SESSION_SECRET=replace-with-a-long-random-string

# --- Optional ---
PORT=8080
NODE_ENV=development
QUERY_CACHE_TTL_SECONDS=300
# When running locally, point at a service-account key JSON.
# In Cloud Run, omit this — the runtime service account is used automatically.
GOOGLE_APPLICATION_CREDENTIALS=./keyfile.json
